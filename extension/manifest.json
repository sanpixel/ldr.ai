{
  "manifest_version": 3,
  "name": "LDR Auto Print",
  "version": "1.0.0",
  "description": "Auto-print highlighted PDF previews from Legal Description Reader",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://ldr.clocknumbers.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://ldr.clocknumbers.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
