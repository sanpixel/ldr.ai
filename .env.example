# Webhook Print Server Configuration

# Server port (default: 8000)
PORT=8000

# Server host (default: 127.0.0.1 for localhost only, use 0.0.0.0 for network access)
HOST=127.0.0.1

# API key for authentication (if not set, a random key will be generated at startup)
API_KEY=your-secret-api-key-here

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum document size in MB (default: 10)
MAX_DOCUMENT_SIZE=10
