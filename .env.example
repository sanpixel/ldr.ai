# Legal Description Reader - Local Development Environment Variables
# Copy this file to .env and fill in your actual values for local development

# ===== REQUIRED FOR CORE FUNCTIONALITY =====

# OpenAI API Configuration (REQUIRED for GPT text processing)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Database Configuration (REQUIRED for authentication and data storage)
SUPABASE_URL=https://xvlzjyjqqgfpcxqnplds.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===== OPTIONAL FEATURES =====

# Google OAuth Configuration (for user authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Drive API Configuration (for Google Drive PDF integration)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# ===== ENVIRONMENT CONFIGURATION =====

# Environment type (development/production)
ENVIRONMENT=development

# Application URL (used for OAuth redirects)
APP_URL=http://localhost:8501

# ===== INSTRUCTIONS =====
# 1. Copy this file: cp .env.example .env (or copy/paste on Windows)
# 2. Fill in your actual API keys and secrets
# 3. Install dependencies: pip install -r requirements.txt
# 4. Run locally: streamlit run main.py
# 5. The .env file is ignored by git so your secrets stay private

# ===== WHERE TO GET KEYS =====
# OPENAI_API_KEY: https://platform.openai.com/api-keys
# SUPABASE keys: Your Supabase project dashboard > Settings > API
# GOOGLE_CLIENT_ID/SECRET: Google Cloud Console > APIs & Services > Credentials
# GOOGLE_DRIVE_API_KEY: Google Cloud Console > APIs & Services > Credentials